{
  "variableFiles": [
    "frontend/src/estilos/listas.css"
  ],
  "includePatterns": [
    "frontend/src/**/*.css",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx"
  ],
  "excludePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.quality-tools/**",
    "**/.quality-reports/**",
    "**/.sentinel/**"
  ],
  "scanAllFiles": false,
  "hardcodedDetection": {
    "enabled": true,
    "severity": "warning",
    "properties": {
      "color": true,
      "background": true,
      "background-color": true,
      "border-color": true,
      "border-radius": true,
      "font-size": true,
      "font-family": true,
      "box-shadow": true,
      "font-weight": true,
      "line-height": true
    },
    "allowedValues": [
      "0",
      "0px",
      "auto",
      "inherit",
      "initial",
      "unset",
      "transparent",
      "currentColor",
      "none"
    ]
  },
  "inlineDetection": {
    "enabled": true,
    "severity": "warning"
  },
  "tokenDetection": {
    "duplicate": {
      "enabled": false,
      "severity": "warning"
    },
    "unused": {
      "enabled": true,
      "severity": "warning"
    }
  },
  "bannedProperties": {
    "enabled": true,
    "severity": "warning",
    "properties": []
  },
  "orphanClassDetection": {
    "minClassLength": 3,
    "excludeClassPatterns": [
      "^fila$",
      "^fila--saliendo$"
    ]
  }
}
