[TEMPLATE]
# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Orígenes explícitos permitidos para peticiones con cookies
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Solo false en loopback local; fuera de loopback el backend lo rechaza.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com
# Solo true si el reverse proxy sobrescribe X-Real-IP/X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Frontend compilado servido por el mismo proceso (opcional en desarrollo)
FRONTEND_DIST=frontend/dist

# Servidor
HOST=127.0.0.1
PORT=3000
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT_SECONDS=5
DB_IDLE_TIMEOUT_SECONDS=600
DB_MAX_LIFETIME_SECONDS=1800
# 60s de margen: los proxies LLM (/api/ai/chat, /api/ai/nutricion) tardan más que el resto.
REQUEST_TIMEOUT_SECONDS=60

# Claves LLM — MISMOS nombres que el proyecto anterior (WordPress/Coolify).
# El backend las lee para /api/ai/chat y /api/ai/nutricion (solo admin; la key
# nunca viaja al navegador). Sin claves, los endpoints devuelven un error claro.
# Cerebras (primera opción del fallback chain): zai-glm-4.7
CEREBRAS_API_KEY=
# Groq: rotación automática entre las 4 (se prueban en orden)
GROQ_API=
GROQ_API_1=
GROQ_API_2=
GROQ_API_3=
# DeepSeek: deepseek-v4-flash (acepta cualquiera de los 3 alias)
DEEPSEEK_API=
DEEPSEEK-API=
DEEPSEEK_API_KEY=
# Glory API = gloryapi LOCAL (proxy OpenAI-compatible 127.0.0.1:3101).
# URL configurable por env; default http://127.0.0.1:3101/v1/chat/completions.
# La key es la "unified key" local de gloryapi (token DPAPI en %USERPROFILE%\.gloryapi).
GLORY_API_URL=http://127.0.0.1:3101/v1/chat/completions
GLORY_API_KEY=
# [02-09-2026] Command Code Provider API DIRECTA (sin gloryapi) para el modelo
# GRATIS `poolside/laguna-s-2.1-free` (Laguna S 2.1 de Poolside, 100% OFF mientras haya
# capacidad). Misma key del Studio/CLI de Command Code. Requiere al menos $1 de
# créditos en la cuenta para arrancar. Endpoint:
# https://api.commandcode.ai/provider/v1/chat/completions (auth Bearer).
COMMAND_CODE_API_KEY=
# Límites por usuario/hora de los proxies IA (defaults del contrato PHP)
AI_CHAT_RATE_LIMIT_PER_HOUR=80
AI_NUTRITION_RATE_LIMIT_PER_HOUR=60

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug
