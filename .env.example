# Base de datos PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/glory_db

# Orígenes explícitos permitidos para peticiones con cookies
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Solo false en loopback local; fuera de loopback el backend lo rechaza.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com
# Solo true si el reverse proxy sobrescribe X-Real-IP/X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Frontend compilado servido por el mismo proceso (opcional en desarrollo)
FRONTEND_DIST=frontend/dist

# Servidor
HOST=127.0.0.1
PORT=3000
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT_SECONDS=5
DB_IDLE_TIMEOUT_SECONDS=600
DB_MAX_LIFETIME_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=30

# Logging (trace, debug, info, warn, error)
RUST_LOG=glory_backend=debug,tower_http=debug
