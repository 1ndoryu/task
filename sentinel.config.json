{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "main"
  },
  "gate": {
    "command": ["sentinel", "check", "--"],
    "taskIdRequired": true
  },
  "guard": {
    "directCommands": {
      "npmScripts": ["test", "build", "type-check", "check", "lint", "fmt"],
      "npxTools": ["tsc", "eslint", "prettier", "rustfmt"],
      "cargoSubcommands": ["check", "clippy", "test", "bench", "fmt"],
      "tools": ["tsc", "eslint", "prettier", "rustfmt"]
    }
  },
  "runtime": {
    "minimumVersion": "0.7.5",
    "protocolVersion": 1,
    "lockFile": "sentinel.lock.json"
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "project-default",
      "config": {
        "includePatterns": [
          "**/*.rs",
          "frontend/**/*.ts",
          "frontend/**/*.tsx",
          "frontend/**/*.js",
          "frontend/**/*.jsx",
          "frontend/**/*.css",
          "scripts/**/*.mjs",
          "scripts/**/*.ps1",
          ".freebuff/*.mjs"
        ],
        "excludePatterns": [
          "**/node_modules/**",
          "**/dist/**",
          "**/out/**",
          "**/target/**",
          "**/.quality-tools/**",
          "**/.quality-reports/**",
          "**/.sentinel/**",
          "glory-sentinel/**",
          "tools/**",
          "frontend/src/api/generated/**"
        ],
        "directoryExceptions": [
          "migrations",
          "scripts",
          "src/handlers",
          "frontend",
          ".freebuff",
          "src/models",
          "src/repositories",
          "src/services"
        ],
        "portableBoundaries": {
          "dom": ["/frontend/src/utils/dom.ts", "/frontend/src/platform/", "/frontend/src/adapters/", "/frontend/src/app/hooks/", "/frontend/src/app/stores/", "/frontend/src/app/components/", "/frontend/src/glory-core/", "/frontend/src/app/islands/", "/frontend/src/app/utils/", "/frontend/src/app/services/", "frontend/src/main.tsx", "frontend/src/app/main.tsx"],
          "window": ["/frontend/src/platform/", "/frontend/src/adapters/", "/frontend/src/navigation/", "/frontend/src/app/hooks/", "/frontend/src/app/stores/", "/frontend/src/app/components/", "/frontend/src/glory-core/", "/frontend/src/app/islands/", "/frontend/src/app/utils/", "/frontend/src/app/services/", "frontend/src/main.tsx", "frontend/src/app/main.tsx"],
          "services": ["/frontend/src/services/", "/frontend/src/api/", "/frontend/src/adapters/"],
          "loggerModules": ["/frontend/src/services/logger", "/frontend/src/utils/logger"]
        },
        "rules": {
          "barras-decorativas": { "severidad": "warning" },
          "catch-vacio": { "severidad": "error" },
          "hardcoded-secret": { "severidad": "error" },
          "innerhtml-variable": { "severidad": "error" },
          "unwrap-produccion-rs": { "severidad": "error" },
          "panic-produccion-rs": { "severidad": "error" },
          "git-add-all": { "severidad": "error" },
          "css-especificacion-diseno-local": { "severidad": "information" },
          "console-production": { "severidad": "information" },
          "unsafe-process-shell": { "severidad": "error" },
          "default-export": { "habilitada": false },
          "mixed-barrel-logic": { "habilitada": false },
          "modal-semantica-no-canonica": { "habilitada": false },
          "modal-con-titulo": { "habilitada": false },
          "modal-estructura-no-canonica": { "habilitada": false },
          "modal-acciones-no-canonico": { "habilitada": false },
          "html-nativo-en-vez-de-componente": { "habilitada": false },
          "button-clase-especifica": { "habilitada": false },
          "componente-sin-hook-glory": { "habilitada": false },
          "menu-contextual-override-diseno": { "habilitada": false },
          "componente-artesanal": { "habilitada": false }
        }
      }
    },
    "varsense": {
      "enabled": true,
      "profile": "project-default",
      "config": "varsense.config.json"
    }
  }
}